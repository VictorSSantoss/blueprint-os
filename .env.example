# Template for .env.local — copy this file, rename it, fill in real values.
# .env.local is gitignored; never commit actual secrets.

# Neon Postgres pooled connection string. Server-side only (api/); never
# referenced from src/, which would ship it to the browser bundle.
DATABASE_URL=

# Neon Auth (Managed Better Auth) with Google sign-in enabled on the project.
VITE_NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=

# FDD-0008 OBJ-02: comma-separated emails allowed to sign in.
ALLOWED_EMAILS=
